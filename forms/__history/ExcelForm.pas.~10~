function GetExcelAppSafe(Ole: TOleContainer): OleVariant;
var
  i: Integer;
begin
  for i := 1 to 10 do
  begin
    try
      Application.ProcessMessages;

      Result := Ole.OleObject.Application;
      Exit;
    except
        Sleep(100);
    end;
  end;

  raise Exception.Create('Excel не отвечает (RPC_E_CALL_REJECTED)');
end;

